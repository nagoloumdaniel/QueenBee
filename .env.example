# QueenBee - variables d'environnement (NOMS SEULEMENT, aucun secret).
# Copier en `.env` (ignoré par git) puis renseigner des valeurs LOCALES.
# `make up` passe ce fichier à Docker Compose (--env-file .env).
# Les variables propres à chaque application sont décrites dans son README / .env.example.
# Production : secrets via SOPS/age ou GitHub Secrets, jamais dans ce fichier.

# --- Base de données (PostgreSQL + PostGIS + TimescaleDB) ---
POSTGRES_USER=queenbee
POSTGRES_PASSWORD=
POSTGRES_DB=queenbee

# --- API ---
QB_JWT_SECRET=
# Mot de passe de démonstration des comptes seedés (hashé en argon2id au chargement)
SEED_DEMO_PASSWORD=

# --- Broker MQTT ---
MQTT_USERNAME=queenbee
MQTT_PASSWORD=

# --- Observabilité / automatisation ---
GRAFANA_ADMIN_PASSWORD=
N8N_ENCRYPTION_KEY=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000/api/v1
SESSION_COOKIE_NAME=qb_session

# --- Mobile (apps/mobile) : passé au build, pas dans ce fichier ---
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1

# --- Déploiement central / site (voir infra/compose/.env.example) ---
QB_VERSION=latest
GHCR_OWNER=
QB_DOMAIN=
QB_SITE_CODE=

# --- Notifications (optionnel, hors dépôt en production) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVICE_ACCOUNT_FILE=
