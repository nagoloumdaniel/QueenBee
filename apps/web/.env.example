# Variables de apps/web (noms seulement, aucune valeur secrète).
# URL publique de l'API (visible du navigateur, donc non secrète)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL de l'API vue depuis le conteneur web (appels serveur)
API_INTERNAL_URL=http://api:8000/api/v1
# Nom du cookie de session (posé httpOnly par l'API ou le BFF)
SESSION_COOKIE_NAME=qb_session
