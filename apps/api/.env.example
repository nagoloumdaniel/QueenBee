# Copier en .env (jamais committé). Aucune valeur réelle ici.
QB_ENV=dev
QB_DATABASE_URL=postgresql+asyncpg://queenbee:change-me@localhost:5432/queenbee
QB_JWT_SECRET=change-me-with-at-least-32-random-bytes
