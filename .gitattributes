# Fins de ligne normalisées en LF (équipe sous Windows et Linux)
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.keystore binary
*.jks binary

# Fichiers générés : ne pas encombrer les diffs de PR
package-lock.json -diff linguist-generated
pubspec.lock -diff linguist-generated
*.g.dart linguist-generated
src/lib/api-types.gen.ts linguist-generated
